# Copy to config.env (which is gitignored) and fill in the target you are attacking.
# The scripts read RT_TARGET from here if you do not pass --target on the CLI.
#
# The value is the blue team's published endpoint: host:port or a full URL.
# e.g.  RT_TARGET=https://track4.hackathon.intlab.ch:8443
#       RT_TARGET=10.20.30.40:8443
RT_TARGET=https://llmhack-team-4.hackathon.intlab.ch
